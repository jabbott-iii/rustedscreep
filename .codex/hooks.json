{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node '/home/jabbott-iii/1projects/rustedscreep/.codex/hooks/guard-bash.mjs'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/home/jabbott-iii/1projects/rustedscreep/.codex/hooks/guard-purity.mjs'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node '/home/jabbott-iii/1projects/rustedscreep/.codex/hooks/session-context.mjs'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node '/home/jabbott-iii/1projects/rustedscreep/.codex/hooks/session-context.mjs'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node '/home/jabbott-iii/1projects/rustedscreep/.codex/hooks/session-context.mjs'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
